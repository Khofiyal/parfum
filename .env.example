# ============================================================
# PARFUM STORE — Environment Variables
# Salin file ini ke .env.local dan isi nilai yang sesuai
# JANGAN commit .env.local ke Git!
# ============================================================

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NODE_ENV=production

# ─── Database (MariaDB) ───────────────────────────────────────
# Read-write user untuk transaksi
DATABASE_URL="mysql://rw_user:STRONG_PASSWORD@127.0.0.1:3306/parfum_db?ssl=true&sslcert=/etc/ssl/certs/ca-certificates.crt"

# Read-only user untuk query produk (opsional, digunakan di lib/db/readonly.ts)
DATABASE_READONLY_URL="mysql://ro_user:STRONG_PASSWORD@127.0.0.1:3306/parfum_db?ssl=true&sslcert=/etc/ssl/certs/ca-certificates.crt"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"
REDIS_PASSWORD=REDIS_STRONG_PASSWORD

# ─── NextAuth / Auth.js ──────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Google OAuth (dari https://console.cloud.google.com)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ─── Midtrans ────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
# "sandbox" atau "production"
MIDTRANS_ENV=sandbox

# ─── Cloudflare R2 ───────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=parfum-store-assets
R2_PUBLIC_URL=https://assets.yourdomain.com

# ─── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=parfum-store
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── Email (untuk notifikasi order, OTP, dll) ────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxx
SMTP_FROM="Parfum Store <noreply@yourdomain.com>"

# ─── Backblaze B2 (untuk backup) ─────────────────────────────
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=parfum-store-backup

# ─── GPG (untuk enkripsi backup) ─────────────────────────────
GPG_RECIPIENT=backup@yourdomain.com

# ─── Rate Limiting ───────────────────────────────────────────
# Max request per window
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_CHECKOUT_MAX=10
RATE_LIMIT_CHECKOUT_WINDOW=300
