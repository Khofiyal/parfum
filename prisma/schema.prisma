// prisma/schema.prisma
// Parfum Store — Database Schema
// Database: MariaDB | ORM: Prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(USER)
  passwordHash  String?   // null untuk OAuth user
  isSuspended   Boolean   @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // Encrypted TOTP secret
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  carts     Cart[]
  reviews   Review[]
  auditLogs AuditLog[]

  @@index([email])
  @@map("users")
}

// ─── NextAuth Tables ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  brand       String
  description String   @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  imageUrls   Json     // String[] — URL foto produk di R2
  // Fragrance notes
  topNotes    Json     // String[]
  middleNotes Json     // String[]
  baseNotes   Json     // String[]
  category    String   // e.g. "floral", "woody", "oriental", "fresh"
  size        String   // e.g. "30ml", "50ml", "100ml"
  concentration String // e.g. "EDP", "EDT", "Parfum", "EDC"
  gender      String   // e.g. "unisex", "masculine", "feminine"
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  orderItems OrderItem[]
  carts      Cart[]
  reviews    Review[]

  @@index([brand])
  @@index([category])
  @@index([isActive])
  @@index([slug])
  @@fulltext([name, brand, description])
  @@map("products")
}

// ─── Address ─────────────────────────────────────────────────────────────────

model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String  // e.g. "Rumah", "Kantor"
  recipientName String
  phone       String
  fullAddress String  @db.Text
  city        String
  province    String
  postalCode  String
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  userId          String
  addressId       String?
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @db.Decimal(12, 2)
  shippingCost    Decimal       @db.Decimal(12, 2) @default(0)
  // Midtrans fields
  paymentId       String?       @unique // Midtrans order_id / transaction_id
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   String?       // "gopay", "bank_transfer", "credit_card", etc.
  snapToken       String?       // Midtrans Snap token
  snapRedirectUrl String?
  paidAt          DateTime?
  // Shipping
  trackingNumber  String?
  shippingCourier String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  // Idempotency
  idempotencyKey  String        @unique @default(cuid())
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  address    Address?    @relation(fields: [addressId], references: [id])
  orderItems OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(12, 2)
  // Snapshot nama produk saat beli (biar tidak berubah kalau produk diedit)
  productName     String
  productImage    String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("carts")
}

// ─── Review ──────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      // 1-5
  comment   String   @db.Text
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Satu user hanya bisa review satu produk sekali
  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g. "CREATE_ORDER", "UPDATE_PRODUCT", "SUSPEND_USER"
  entity    String   // e.g. "Order", "Product", "User"
  entityId  String?
  metadata  Json?    // Data tambahan (IP, perubahan field, dll)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
